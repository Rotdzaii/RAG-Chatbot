DATABASE_URL=postgresql+psycopg://rag_chatbot:password@db.example.com:5432/rag_chatbot?sslmode=require
GEMINI_API_KEY=replace-with-your-api-key
RAG_TRACE_ENABLED=false
# Chat defaults to gemini-3.6-flash; set either value to gemini-3.8-flash to override.
RAG_QUERY_MODEL=gemini-3.6-flash
RAG_GENERATION_MODEL=gemini-3.6-flash
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
# OCR fallback for textless PDF pages; install Tesseract and vie + eng traineddata.
RAG_TESSERACT_CMD=tesseract
# Windows without Tesseract on PATH: RAG_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
RAG_OCR_TIMEOUT_SECONDS=60
